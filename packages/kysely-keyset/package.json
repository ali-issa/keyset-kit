{
  "name": "kysely-keyset",
  "version": "0.0.0",
  "description": "Keyset pagination for Kysely on PostgreSQL: filters, relationship predicates, aggregate sorts, text search, totals, range requests, and HMAC-signed cursors, rendered from keyset-kit's query plan onto your own select query.",
  "keywords": [
    "cursor",
    "cursor-pagination",
    "keyset",
    "keyset-pagination",
    "kysely",
    "pagination",
    "postgres",
    "postgresql",
    "seek"
  ],
  "homepage": "https://github.com/ali-issa/keyset-kit/tree/main/packages/kysely-keyset#readme",
  "bugs": "https://github.com/ali-issa/keyset-kit/issues",
  "license": "MIT",
  "author": "Ali Issa (https://github.com/ali-issa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-issa/keyset-kit.git",
    "directory": "packages/kysely-keyset"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "keyset-kit": "workspace:^"
  },
  "devDependencies": {
    "kysely": "0.29.6"
  },
  "peerDependencies": {
    "kysely": ">=0.28.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
